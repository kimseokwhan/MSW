# 이 파일을 복사해 같은 폴더에 .env 로 저장한 뒤 값을 채운다.
#   Windows : copy .env.example .env
# .env 는 형상관리에 올리지 않는다. (키가 들어 있다)

# SSAFY GMS 키 (https://gms.ssafy.io/web/)
GMS_KEY=
# 공공데이터포털 '한국대학교육협의회_대학별 학과정보_GW' 일반 인증키(Decoding)
DATA_API_KEY=
# 위키백과 API User-Agent 연락처 (각자 이메일)
WIKI_CONTACT=

# (선택) 모델·청킹·검색 설정 덮어쓰기
# CHAT_MODEL=gpt-4.1-mini
# EMBED_MODEL=text-embedding-3-small
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=5
